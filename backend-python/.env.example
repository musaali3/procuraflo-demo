PORT=8001
JWT_SECRET=change-this-secret-in-production
RUNTIME_DATA_DIR=../runtime-data
DB_PATH=../runtime-data/procuraflow.db
UPLOADS_DIR=../runtime-data/uploads
BACKUPS_DIR=../runtime-data/backups
# In production, point this to a persistent disk. Each registered company gets
# an isolated SQLite database and the tenant registry is stored here.
TENANT_DATA_DIR=../runtime-data/tenants
# Keep false for customer deployments. Set true only for a controlled hosted
# multi-company service where you intentionally allow more than one tenant DB.
ALLOW_MULTIPLE_COMPANIES=false
LICENSED_COMPANY_NAME=
LICENSED_HOSTNAMES=
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:4173
CALENDARIFIC_API_URL=https://calendarific.com/api/v2
CALENDARIFIC_API_KEY=
NAGER_HOLIDAY_API_URL=https://date.nager.at/api/v3
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_RATE_API_KEY=
